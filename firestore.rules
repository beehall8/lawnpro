rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'wMtrFLvsXUObDuRDMyKQcPqXvwD2';
    }

    function isValidApplication(uid) {
      return request.resource.data.keys().hasOnly([
          'userId', 'name', 'businessName', 'email', 'phone', 'zipCode',
          'experience', 'services', 'availability', 'notes', 'insured',
          'agreed', 'status', 'createdAt', 'reviewedAt'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.zipCode.matches('^[0-9]{5}$')
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 6
        && request.resource.data.insured is bool
        && request.resource.data.agreed == true
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == null;
    }

    match /vendorApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && isValidApplication(uid);

      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    function isApprovedVendor() {
      return signedIn()
        && exists(/databases/$(database)/documents/vendorApplications/$(request.auth.uid))
        && get(/databases/$(database)/documents/vendorApplications/$(request.auth.uid)).data.status == 'APPROVED';
    }

    match /jobs/{jobId} {
      // Only the trusted checkout function may create paid jobs. It uses the
      // Admin SDK and therefore does not rely on a client-side allow rule.
      allow create: if false;

      allow get, list: if isAdmin()
        || (isApprovedVendor()
          && (resource.data.status == 'PENDING'
            || resource.data.assignedVendorId == request.auth.uid));

      allow update: if isApprovedVendor()
        && resource.data.status == 'PENDING'
        && resource.data.assignedVendorId == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedVendorId', 'acceptedAt'])
        && request.resource.data.status == 'ACCEPTED'
        && request.resource.data.assignedVendorId == request.auth.uid
        && request.resource.data.acceptedAt == request.time;

      allow delete: if false;
    }
  }
}
