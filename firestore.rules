rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'wMtrFLvsXUObDuRDMyKQcPqXvwD2';
    }

    function isValidApplication(uid) {
      return request.resource.data.keys().hasOnly([
          'userId', 'name', 'businessName', 'email', 'phone', 'zipCode',
          'experience', 'services', 'availability', 'notes', 'insured',
          'agreed', 'status', 'createdAt', 'reviewedAt'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.zipCode.matches('^[0-9]{5}$')
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 6
        && request.resource.data.insured is bool
        && request.resource.data.agreed == true
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == null;
    }

    match /vendorApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && isValidApplication(uid);

      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    function isApprovedVendor() {
      return signedIn()
        && exists(/databases/$(database)/documents/vendorApplications/$(request.auth.uid))
        && get(/databases/$(database)/documents/vendorApplications/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isValidNewJob() {
      return request.resource.data.keys().hasOnly([
          'customerName', 'customerEmail', 'customerPhone', 'address',
          'services', 'serviceNames', 'frequency', 'frequencyName',
          'lawnSizeId', 'lawnSizeName', 'lawnSizeRange', 'measuredArea',
          'scheduledDate', 'timeWindow', 'notes', 'estimatedMin',
          'estimatedMax', 'estimateOpenEnded', 'status', 'assignedVendorId', 'createdAt',
          'acceptedAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 6
        && request.resource.data.customerPhone.size() <= 40
        && request.resource.data.address is map
        && request.resource.data.address.keys().hasOnly(['street', 'city', 'state', 'zip'])
        && request.resource.data.address.street is string
        && request.resource.data.address.street.size() > 2
        && request.resource.data.address.street.size() <= 160
        && request.resource.data.address.city is string
        && request.resource.data.address.city.size() > 1
        && request.resource.data.address.city.size() <= 80
        && request.resource.data.address.state == 'GA'
        && request.resource.data.address.zip.matches('^[0-9]{5}$')
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 6
        && request.resource.data.serviceNames is list
        && request.resource.data.serviceNames.size() == request.resource.data.services.size()
        && request.resource.data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timeWindow is string
        && request.resource.data.timeWindow.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.estimatedMin is number
        && request.resource.data.estimatedMin >= 0
        && request.resource.data.estimatedMax is number
        && request.resource.data.estimatedMax >= request.resource.data.estimatedMin
        && request.resource.data.estimateOpenEnded is bool
        && request.resource.data.status == 'PENDING'
        && request.resource.data.assignedVendorId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedAt == null;
    }

    match /jobs/{jobId} {
      allow create: if isValidNewJob();

      allow get, list: if isAdmin()
        || (isApprovedVendor()
          && (resource.data.status == 'PENDING'
            || resource.data.assignedVendorId == request.auth.uid));

      allow update: if isApprovedVendor()
        && resource.data.status == 'PENDING'
        && resource.data.assignedVendorId == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedVendorId', 'acceptedAt'])
        && request.resource.data.status == 'ACCEPTED'
        && request.resource.data.assignedVendorId == request.auth.uid
        && request.resource.data.acceptedAt == request.time;

      allow delete: if false;
    }
  }
}
