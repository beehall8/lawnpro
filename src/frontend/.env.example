# Copy to .env and fill in real values. See /ENV_VARIABLES.md for details.
# NOTE: All VITE_* vars are exposed to the browser. Never put secrets here.

# API
VITE_API_URL=http://localhost:5000
VITE_HERO_VIDEO_URL=
VITE_API_VERSION=v1

# Google Maps (same key as backend, restricted to HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# Stripe (PUBLISHABLE key only - pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Feature flags
VITE_ENABLE_SATELLITE_ESTIMATION=true
VITE_ENABLE_REVIEWS=true

# Optional analytics
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
