# Copy to .env and fill in real values. See /ENV_VARIABLES.md for details.

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/lawnpro

# Vendor application admin page (use a long, unique passcode)
VENDOR_ADMIN_KEY=replace-with-long-random-admin-passcode

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-32-char-random-hex
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-different-32-char-random-hex
JWT_REFRESH_EXPIRES_IN=30d

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=AIza...

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email - Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@lawnpro.com

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Redis (Railway auto-injects)
REDIS_URL=redis://localhost:6379

# Optional: Monitoring
SENTRY_DSN=
LOG_LEVEL=info
